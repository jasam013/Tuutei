# Copy to /etc/tutei/*.env (mode 600) on the server. Never commit real values.
PORT=8787
TUTEI_DATA_DIR=/var/lib/tutei

# Live triage (OPENCLAW.md)
TUTEI_OPENCLAW_URL=http://192.168.100.21:18789
TUTEI_OPENCLAW_TOKEN=
TUTEI_OPENCLAW_AGENT=default
TUTEI_OPENCLAW_TIMEOUT_MS=180000

# Gitea wiki over mutual TLS (WIKI.md)
TUTEI_GITEA_URL=https://gitea.edustack.internal:3000
TUTEI_GITEA_REPO=owner/soc-wiki
TUTEI_GITEA_TOKEN=
TUTEI_GITEA_CA=/etc/tutei/pki/root_ca.crt
TUTEI_GITEA_CERT=/etc/tutei/pki/tutei.crt
TUTEI_GITEA_KEY=/etc/tutei/pki/tutei.key

# Piper natural voices (TTS.md)
TUTEI_TTS_URL=http://192.168.100.25:5000
